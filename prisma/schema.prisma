// Equapar — modelo de dados
// Conta = quem assina (empresa ou assessoria). Empresa = CNPJ atendido (1 numa empresa, N numa assessoria).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TipoConta {
  EMPRESA
  ASSESSORIA
}

enum Plano {
  GRATIS
  PILOTO
  CARTEIRA
  ASSESSORIA
}

enum Papel {
  DONO
  GERENTE
  CONTADOR
  LEITURA
}

enum TipoReajuste {
  REPACTUACAO
  INDICE
}

enum SituacaoConvencao {
  REGISTRADA
  PENDENTE
}

// Os 6 estados do dinheiro (Dossiê, "Como funciona" item 6) + INDEFERIDO
enum EstadoPedido {
  EM_ANALISE
  CALCULO_VALIDADO
  PROTOCOLADO
  DEFERIDO
  FATURADO
  RECEBIDO
  INDEFERIDO
}

enum Gatilho {
  NOVA_CONVENCAO
  ACORDO_DISSIDIO
  OUTRO_CUSTO
}

enum CanalAviso {
  EMAIL
  WHATSAPP
}

enum StatusAviso {
  SIMULADO
  ENVIADO
  ERRO
}

model Usuario {
  id                 String    @id @default(cuid())
  nome               String
  email              String    @unique
  senhaHash          String?
  googleId           String?   @unique
  whatsapp           String?
  whatsappConsentEm  DateTime?
  totpSegredoCifrado String?
  totpAtivo          Boolean   @default(false)
  emailVerificadoEm   DateTime? // C7: confirmação do e-mail
  totpSegredoPendente String? // C8: segredo novo até confirmar (cifrado)
  codigosRecuperacao  String[]  @default([]) // C8: hashes dos códigos de recuperação
  // preferências de aviso: { prazo: "EMAIL"|"WHATSAPP"|"AMBOS", resposta: ..., deferido: ..., semanal: bool, hora: 7 }
  prefsAvisos        Json?
  criadoEm           DateTime  @default(now())

  sessoes     Sessao[]
  membros     Membro[]
  historicos  Historico[]
  comentarios ComentarioLinha[]
}

model Sessao {
  id         String   @id // hash SHA-256 do token do cookie
  usuarioId  String
  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  contaId    String?
  empresaId  String? // empresa selecionada (assessoria)
  pendente2fa Boolean @default(false)
  userAgent  String?
  criadoEm   DateTime @default(now())
  expiraEm   DateTime
  vistoEm    DateTime @default(now())

  @@index([usuarioId])
}

model Conta {
  id                      String    @id @default(cuid())
  nome                    String
  tipo                    TipoConta @default(EMPRESA)
  plano                   Plano     @default(GRATIS)
  marcaNome               String? // assessoria: nome nos PDFs
  marcaCor                String? // assessoria: cor nos PDFs
  marcaLogo               String? // assessoria: caminho do logo (PNG/JPG) no armazenamento
  mostrarValoresWhatsapp  Boolean   @default(false)
  pilotoInicio            DateTime?
  planoPendente           Plano? // 4.2: plano escolhido, vale quando o pagamento for confirmado
  ciclo                   String    @default("MENSAL") // 4.2: MENSAL ou ANUAL
  situacaoCobranca        String    @default("EM_DIA") // 4.2: EM_DIA, ATRASADA, CARENCIA, SOMENTE_LEITURA
  carenciaAte             DateTime? // 4.2: fim da carência antes de virar somente leitura
  gatewayClienteId        String? // 4.2: id do cliente no gateway de pagamento
  criadoEm                DateTime  @default(now())
  demo                    Boolean   @default(false) // C6: conta de demonstração de um visitante
  demoExpiraEm            DateTime? // C6: quando a conta de demonstração vence

  membros     Membro[]
  empresas    Empresa[]
  convencoes  Convencao[]
  historicos  Historico[]
  avisos      Aviso[]
  tarefas     Tarefa[]
  faturas     Fatura[]
  trabalhos   TrabalhoFundo[]
}

model Membro {
  id        String  @id @default(cuid())
  usuarioId String
  contaId   String
  papel     Papel
  usuario   Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  conta     Conta   @relation(fields: [contaId], references: [id], onDelete: Cascade)
  criadoEm  DateTime @default(now())

  @@unique([usuarioId, contaId])
}

model Empresa {
  id          String     @id @default(cuid())
  contaId     String
  conta       Conta      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  cnpj        String
  razaoSocial String
  exemplo     Boolean    @default(false) // dado fictício de demonstração
  criadoEm    DateTime   @default(now())
  contratos   Contrato[]

  @@unique([contaId, cnpj])
}

model Convencao {
  id            String            @id @default(cuid())
  contaId       String
  conta         Conta             @relation(fields: [contaId], references: [id], onDelete: Cascade)
  nome          String // ex.: "CCT Asseio e Conservação ES 2026"
  sindicatos    String?
  categoria     String            @default("Asseio e conservação")
  cidade        String?
  uf            String
  ano           Int
  mesDataBase   Int // 1..12
  situacao      SituacaoConvencao @default(PENDENTE)
  dataDeposito  DateTime?
  registroMte   String? // número no sistema Mediador
  observacoes   String?
  criadoEm      DateTime          @default(now())

  contratos     Contrato[]
  pedidos       Pedido[]
  documentos    Documento[]
}

model Contrato {
  id                  String       @id @default(cuid())
  empresaId           String
  empresa             Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  numero              String
  orgao               String
  orgaoCnpj           String?
  uf                  String?
  municipio           String?
  esfera              String? // F, E, M, D
  objeto              String
  vigenciaInicio      DateTime
  vigenciaFim         DateTime
  vigenciaFimPncp     DateTime? // L4: último fim de vigência lido do PNCP
  valorMensal         Decimal?     @db.Decimal(14, 2)
  valorGlobal         Decimal?     @db.Decimal(16, 2)
  postos              Int?
  maoDeObraDedicada   Boolean      @default(false)
  tipoReajuste        TipoReajuste @default(REPACTUACAO)
  clausulaReajuste    String?
  convencaoId         String?
  convencao           Convencao?   @relation(fields: [convencaoId], references: [id], onDelete: SetNull)
  dataProposta        DateTime?
  ultimoApostilamento DateTime?
  pncpControle        String?
  linkPncp            String?
  arquivado           Boolean      @default(false)
  criadoEm            DateTime     @default(now())
  prorrogacoes        Prorrogacao[]

  pedidos    Pedido[]
  documentos Documento[]
  historicos Historico[]
  avisos     Aviso[]
  tarefas    Tarefa[]

  @@unique([empresaId, pncpControle])
}

model Pedido {
  id                  String       @id @default(cuid())
  contratoId          String
  contrato            Contrato     @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  estado              EstadoPedido @default(EM_ANALISE)
  passoAtual          Int          @default(1)
  gatilho             Gatilho      @default(NOVA_CONVENCAO)
  convencaoId         String?
  convencao           Convencao?   @relation(fields: [convencaoId], references: [id], onDelete: SetNull)
  dataBase            DateTime? // início dos efeitos financeiros
  dataDeposito        DateTime?
  descricaoGatilho    String?
  // Planilhas de custos (formato PlanilhaCustos de src/lib/calculo)
  planilhaAntes       Json?
  planilhaAgora       Json?
  linhasNaoLidas      Json? // linhas que a leitura não entendeu
  checklist           Json? // { [id]: "ANEXADO" | "FALTA" | "OPCIONAL" }
  dataReferencia      DateTime? // até quando contar a diferença retroativa
  retroContarAte      RetroContarAte  @default(DATA_INFORMADA) // L11: até quando conta a diferença
  retroMesIncompleto  RetroMesIncompleto @default(DIAS_CORRIDOS) // L11: mês incompleto
  hashCalculo         String? // C2: SHA-256 da base do cálculo no momento da aprovação
  diferencaMensal     Decimal?     @db.Decimal(14, 2)
  diferencaRetroativa Decimal?     @db.Decimal(14, 2)
  memoriaAprovadaPor  String?
  memoriaAprovadaEm   DateTime?
  revisaoEspecialista Boolean      @default(false)
  geradoEm            DateTime?
  protocoloNumero     String?
  protocoloData       DateTime?
  respostaData        DateTime?
  respostaResumo      String?
  deferidoEm          DateTime?
  valorDeferido       Decimal?     @db.Decimal(14, 2)
  apostiladoEm        DateTime?
  faturadoEm          DateTime?
  notaFiscal          String?
  recebidoEm          DateTime?
  valorRecebido       Decimal?     @db.Decimal(14, 2)
  criadoEm            DateTime     @default(now())
  atualizadoEm        DateTime     @updatedAt

  documentos  Documento[]
  comentarios ComentarioLinha[]
  historicos  Historico[]
}

model Documento {
  id          String     @id @default(cuid())
  contratoId  String?
  contrato    Contrato?  @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pedidoId    String?
  pedido      Pedido?    @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  convencaoId String?
  convencao   Convencao? @relation(fields: [convencaoId], references: [id], onDelete: Cascade)
  tipo        String // PLANILHA, CONVENCAO, OFICIO, PROTOCOLO, APOSTILAMENTO, NOTA_FISCAL, OUTRO
  nome        String
  versao      Int        @default(1)
  mime        String
  tamanho     Int
  caminho     String
  enviadoPor  String?
  criadoEm    DateTime   @default(now())
}

model ComentarioLinha {
  id        String   @id @default(cuid())
  pedidoId  String
  pedido    Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  linhaId   String
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  texto     String
  criadoEm  DateTime @default(now())
}

model Historico {
  id         String    @id @default(cuid())
  contaId    String
  conta      Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  pedidoId   String?
  pedido     Pedido?   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  usuarioId  String?
  usuario    Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  acao       String
  detalhe    String?
  criadoEm   DateTime  @default(now())

  @@index([contaId, criadoEm])
}

model Tarefa {
  id         String    @id @default(cuid())
  contaId    String
  conta      Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  contratoId String?
  contrato   Contrato? @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  titulo     String
  prazo      DateTime?
  feitaEm    DateTime?
  criadoEm   DateTime  @default(now())
}

model Aviso {
  id         String      @id @default(cuid())
  contaId    String?
  conta      Conta?      @relation(fields: [contaId], references: [id], onDelete: Cascade)
  contratoId String?
  contrato   Contrato?   @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  chave      String // idempotência: ex. "D60:contratoId:2027-03-01"
  tipo       String // D60, D30, D7, RESPOSTA, DEFERIDO, SEMANAL, APOSTILAMENTO
  canal      CanalAviso
  destino    String
  assunto    String?
  corpo      String
  status     StatusAviso
  erro       String?
  enviadoEm  DateTime    @default(now())

  @@unique([chave, canal, destino])
  @@index([contaId, enviadoEm])
}

model Fatura {
  id         String   @id @default(cuid())
  contaId    String
  conta      Conta    @relation(fields: [contaId], references: [id], onDelete: Cascade)
  referencia String // "2026-11"
  descricao  String
  valor      Decimal  @db.Decimal(12, 2)
  postos     Int?
  pagaEm     DateTime?
  status        String    @default("ABERTA") // 4.2: ABERTA, PAGA, FALHOU, CANCELADA
  vencimento    DateTime?
  tentativas    Int       @default(0)
  metodo        String? // PIX, BOLETO, CARTAO
  gatewayId     String?   @unique
  linkPagamento String?
  notaFiscalUrl String?
  criadoEm   DateTime @default(now())
}

// Raio-X: contato deixado para receber o relatório (só com consentimento)
model Lead {
  id                 String   @id @default(cuid())
  cnpj               String
  email              String
  whatsapp           String?
  consentimentoAvisos Boolean @default(false)
  criadoEm           DateTime @default(now())
}

model RaioXCache {
  cnpj        String   @id
  resultado   Json
  consultadoEm DateTime @default(now())
}

// Eventos de produto: nunca guardam dado pessoal
model Evento {
  id       String   @id @default(cuid())
  nome     String
  props    Json?
  criadoEm DateTime @default(now())

  @@index([nome, criadoEm])
}

// Tarefa demorada em segundo plano (ex.: exportar tudo). Avisa no sino quando termina.
model TrabalhoFundo {
  id          String    @id @default(cuid())
  contaId     String
  conta       Conta     @relation(fields: [contaId], references: [id], onDelete: Cascade)
  usuarioId   String
  tipo        String // EXPORTAR
  status      String // RODANDO, PRONTO, ERRO
  caminho     String?
  erro        String?
  criadoEm    DateTime  @default(now())
  concluidoEm DateTime?
  vistoEm     DateTime?

  @@index([usuarioId, criadoEm])
}

/// S1: tentativas de acesso (por e-mail e por IP), no banco em vez da memória do processo.
model TentativaAcesso {
  chave        String    @id // "email:<e-mail>" ou "ip:<ip>"
  falhas       Int       @default(0)
  janelaAte    DateTime
  bloqueadoAte DateTime?
}

/// L11: até quando a diferença retroativa é contada (padrão = comportamento atual)
enum RetroContarAte {
  DATA_INFORMADA
  DATA_PROTOCOLO
  DATA_APOSTILAMENTO
}

/// L11: como conta o mês incompleto (padrão = comportamento atual)
enum RetroMesIncompleto {
  DIAS_CORRIDOS
  MES_30_DIAS
}

/// L17: prorrogações do contrato (termo aditivo), com ou sem ressalva do direito à repactuação
model Prorrogacao {
  id            String   @id @default(cuid())
  contratoId    String
  contrato      Contrato @relation(fields: [contratoId], references: [id], onDelete: Cascade)
  dataTermo     DateTime
  novoFim       DateTime
  comRessalva   Boolean  @default(false)
  textoRessalva String?
  registradoPor String?
  criadoEm      DateTime @default(now())

  @@index([contratoId])
}

/// 4.1.1: fila de tarefas no próprio PostgreSQL (worker separado: npm run worker)
model TarefaFila {
  id            String    @id @default(cuid())
  tipo          String // AVISOS, PNCP_RETENTAR, EXPORTAR, LER_PDF, GERAR_ZIP, ENVIAR_MENSAGEM
  dados         Json?
  chave         String?   @unique // evita a mesma tarefa duas vezes (ex.: "avisos:2026-11-12T15")
  status        String    @default("PENDENTE") // PENDENTE, RODANDO, FEITA, FALHOU
  tentativas    Int       @default(0)
  maxTentativas Int       @default(5)
  proximaEm     DateTime  @default(now())
  travadaAte    DateTime?
  travadaPor    String?
  erro          String?
  criadaEm      DateTime  @default(now())
  concluidaEm   DateTime?

  @@index([status, proximaEm])
}

/// 4.2: eventos recebidos do gateway (cada um processado uma vez só)
model EventoCobranca {
  id         String   @id // id do evento no gateway
  tipo       String
  recebidoEm DateTime @default(now())
}
