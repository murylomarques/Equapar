# HTTPS automático (Let's Encrypt) para os domínios em DOMINIO (separados por vírgula e espaço).
# O app lê o IP do cliente em X-Real-IP (TRUSTED_PROXY_HEADER=x-real-ip); o Caddy sempre sobrescreve o valor.
{$DOMINIO} {
	encode zstd gzip
	reverse_proxy app:3000 {
		header_up X-Real-IP {remote_host}
	}
}
