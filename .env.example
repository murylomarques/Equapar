# =====================================================================================
# Equapar: variáveis de ambiente (G1). Copie para .env (ou para o painel de segredos da
# hospedagem) e preencha. NUNCA coloque valores reais no repositório.
#
# Três blocos:
#   1. PARA SUBIR   o sistema não sobe sem elas.
#   2. PARA VENDER  e-mail, captcha, login com Google e dados da empresa (SITE_*).
#   3. DEPOIS       Asaas, Anthropic, WhatsApp da Meta e as chaves de recurso.
#
# Para cada uma: o que é · obrigatória? · onde se obtém · formato (exemplo FICTÍCIO) · o que acontece vazia.
# Confira tudo com: npm run verificar:producao (nunca imprime segredos).
# =====================================================================================


# ===================================== 1. PARA SUBIR =====================================

# Banco PostgreSQL 17. OBRIGATÓRIA.
# Onde: painel do banco gerenciado (string de conexão). Local: `docker compose up -d` (porta 5440); use 127.0.0.1.
# Formato: postgresql://usuario:senha@host:5432/equapar?schema=public · Vazia: o sistema não sobe.
DATABASE_URL="postgresql://equapar:equapar_local@127.0.0.1:5440/equapar?schema=public"

# Segredo da aplicação (cifra o segredo das duas etapas e assina links de confirmação, senha, convite e Raio-X). OBRIGATÓRIA.
# Onde: gere você mesmo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Formato: 32 caracteres ou mais · Vazia: o sistema não sobe. Trocar invalida links e o segredo das duas etapas.
APP_SECRET=""

# Endereço público do sistema. OBRIGATÓRIA.
# Onde: o domínio contratado (equapar.com.br). Formato: https://equapar.com.br
# Em produção precisa ser HTTPS (liga o cookie __Host-, o HSTS e o upgrade-insecure-requests) · Vazia: links dos avisos quebram.
APP_URL="http://localhost:3000"

# Cabeçalho com o IP do cliente, posto pelo proxy de confiança da hospedagem. OBRIGATÓRIA em produção.
# Onde: documentação da hospedagem/CDN. Formato: cf-connecting-ip | x-real-ip | x-forwarded-for
# Vazia: os limites por IP (tentativas de acesso, cotas do Raio-X, 3 demonstrações por IP por hora) ficam desligados.
TRUSTED_PROXY_HEADER=""

# Armazenamento dos arquivos enviados. OBRIGATÓRIA em produção (s3).
# Formato: s3 · Vazia: disco local (STORAGE_DIR); serve para desenvolvimento, não para produção.
ARMAZENAMENTO=""
# Pasta no modo disco. Opcional. Formato: ./storage · Vazia: ./storage
STORAGE_DIR="./storage"
# Bucket PRIVADO com versionamento, região e (para compatíveis) o endpoint. OBRIGATÓRIAS com ARMAZENAMENTO=s3.
# Onde: painel do provedor de armazenamento (ex.: AWS S3). Formato: equapar-arquivos · sa-east-1 · https://s3.exemplo.com
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
# Credenciais do bucket (ou o papel da máquina). Onde: IAM do provedor. Formato: AKIA... e chave secreta.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Nome do provedor de hospedagem, para a lista de subprocessadores da política de privacidade. Opcional.
# Formato: Nome do provedor · Vazia: "provedor de hospedagem informado na contratação".
HOSPEDAGEM_PROVEDOR=""

# E-mails (separados por vírgula) que veem o painel interno /app/interno e recebem o e-mail de teste. Opcional.
# Formato: dono@exemplo.com,socio@exemplo.com · Vazia: ninguém vê o painel.
PAINEL_EMAILS=""

# Alerta de erro: endpoint que recebe JSON (relay do Sentry, Slack, Better Stack...). Opcional.
# Onde: painel do serviço de alerta. Formato: https://hooks.exemplo.com/... · Vazia: só o log (simulação).
ERROS_WEBHOOK_URL=""

# Avisos de prazo. Com o worker (npm run worker:prod) deixe vazio; "true" só se o próprio app rodar os avisos de hora em hora.
AVISOS_AUTOMATICOS=""
# Segredo do agendador externo que chama /api/cron/avisos (Authorization: Bearer ...). Opcional. Vazia: a rota recusa.
CRON_SECRET=""


# ===================================== 2. PARA VENDER =====================================

# E-mail (SMTP). Sem ele ninguém confirma conta nem recebe aviso. Necessária para vender.
# Onde: painel do provedor de e-mail transacional. Formato: smtps://usuario:senha@smtp.exemplo.com:465
# Vazia: SIMULAÇÃO (a mensagem vai para o log e para a tela Avisos); /api/saude e o painel avisam.
SMTP_URL=""
# Remetente. Formato: Equapar Avisos <avisos@equapar.com.br> · Vazia: "Equapar Avisos <avisos@<domínio do SITE_EMAIL_CONTATO>>".
EMAIL_FROM="Equapar Avisos <avisos@equapar.com.br>"

# Captcha Cloudflare Turnstile nos formulários públicos e no botão da demonstração. As DUAS juntas.
# Onde: painel da Cloudflare > Turnstile. Formato: 0x4AAAAAAA... · Vazias: SIMULAÇÃO (aceita e registra no log).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Login com Google (OAuth). As DUAS juntas. Opcional.
# Onde: Google Cloud Console > Credenciais (redirecionamento: APP_URL/api/auth/google/callback). Vazias: o botão não aparece.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Dados da empresa no site (B1). Nenhum valor real fica no código. O site reflete em até 1 minuto depois de subir.
# E-mail público de contato. Vazia: contato@equapar.com.br
SITE_EMAIL_CONTATO=""
# WhatsApp comercial, só dígitos com DDI e DDD. Formato (fictício): 5511900000000 · Vazia: nenhum botão de WhatsApp; o contato vira e-mail.
SITE_WHATSAPP=""
# Nome do fundador, como deve aparecer. Vazia: o bloco "quem faz" mostra só a empresa.
SITE_FUNDADOR_NOME=""
# Caminho de uma foto em /public. Formato: /fundador.jpg · Vazia: espaço reservado neutro, sem foto de banco de imagens.
SITE_FUNDADOR_FOTO=""
# Razão social. Vazia: "Equapar" (sem selo; sem CNPJ, os termos identificam "Equapar, sob a responsabilidade de <SITE_FUNDADOR_NOME>, <SITE_CIDADE>", sem CPF).
SITE_RAZAO_SOCIAL=""
# Sem CNPJ (operação como pessoa física): nome completo do responsável e CPF, exigidos para vender pela internet
# (Decreto 7.962/2013). Aparecem nos termos, na privacidade e no rodapé. CPF inválido não aparece. Vazias: sem CPF.
SITE_RESPONSAVEL_NOME=""
SITE_CPF=""
# CNPJ, numérico ou alfanumérico (validado; inválido não aparece e o build avisa). Vazia: não aparece.
SITE_CNPJ=""
# Endereço comercial ou fiscal. Vazia: mostra só a cidade.
SITE_ENDERECO=""
# Cidade e UF. Formato: Cidade/UF · Vazia: não aparece.
SITE_CIDADE=""
# Link de agenda ("Marcar uma conversa"). Formato: https://agenda.exemplo.com/equapar · Vazia: o contato usa WhatsApp ou e-mail.
SITE_AGENDA_URL=""


# ===================================== 3. DEPOIS =====================================

# --- Cobrança (Asaas). Vazia = SIMULAÇÃO: a tela simula pagamento e vencimento. Ligar depois do CNPJ. ---
# Chave da API. Onde: Asaas > Integrações. Formato: $aact_hmlg_... (sandbox) ou $aact_prod_... (produção).
# Em arquivo .env, ESCAPE o "$" inicial: ASAAS_API_KEY="\$aact_hmlg_...". Sem a barra o Next lê "$aact…" como
# variável e a chave fica vazia (o sistema volta para a simulação sem avisar). No painel do provedor, cole sem a barra.
ASAAS_API_KEY=""
# "producao" usa https://api.asaas.com/v3; qualquer outro valor, o sandbox. Precisa combinar com o prefixo da chave.
ASAAS_AMBIENTE=""
# Token do webhook (32 a 255 caracteres; não é a chave da API). OBRIGATÓRIA com o Asaas ligado.
# Webhook no Asaas: APP_URL/api/cobranca/asaas, eventos PAYMENT_*.
ASAAS_WEBHOOK_TOKEN=""
# "true" passa a exigir plano: Grátis não gera pedido; Assessoria até ASSESSORIA_MAX_CLIENTES (padrão 20).
COBRANCA_EXIGIR_PLANO=""
ASSESSORIA_MAX_CLIENTES=""
# Desconto do plano anual, em %. Vazia: 0.
# Anual: 12 meses pelo preço de N (1 a 12; padrão 10)
MESES_PAGOS_ANUAL=""
# Só para homologação SEM Asaas: "true" mostra "Simular pagamento" mesmo com NODE_ENV=production. Nunca em produção real.
COBRANCA_SIMULACAO=""

# --- IA (Anthropic). Vazia = nada de IA aparece. ---
# Onde: console da Anthropic > API keys. Formato: sk-ant-...
ANTHROPIC_API_KEY=""
# Chaves da leitura com IA (E1). "true" libera para todos; vazio/false: só os e-mails de PAINEL_EMAILS veem, com o selo "em teste".
# Ligue só depois da avaliação com o gabarito conferido por uma pessoa (scripts/avaliar-ia-convencao.ts).
IA_LEITURA_PLANILHA=""
IA_LEITURA_CONVENCAO=""
# Orçamento de IA (P0). Padrão ZERO em tudo: sem valor explícito, nenhuma chamada paga acontece.
# Cada leitura reserva o pior custo antes de chamar a API e consolida o custo real depois (docs/auditoria/IA.md).
# Teto do SaaS inteiro no mês, em US$.
IA_ORCAMENTO_GLOBAL_USD_MES=""
# Teto por conta no mês, em US$, por plano. O Grátis é sempre zero.
IA_ORCAMENTO_PILOTO_USD_MES=""
IA_ORCAMENTO_CARTEIRA_USD_MES=""
IA_ORCAMENTO_ASSESSORIA_USD_MES=""
# Avaliações internas (scripts/avaliar-ia-convencao.ts), dentro do teto global.
IA_ORCAMENTO_AVALIACAO_USD_MES=""
# "true" desliga toda a IA na hora (emergência).
IA_DESLIGADA=""
# Modelo (padrão claude-opus-5-5). Trocar só depois de comparar na avaliação com o gabarito.
IA_MODELO=""
# Limites por leitura. Vazio: 10 leituras por usuário em 24 h, 1 por conta ao mesmo tempo, 4 no total, 40 páginas, 10 MB,
# 16.000 tokens de saída, 2 tentativas, margem 1,2 sobre o pior caso, 4.000 tokens por página, reserva expira em 15 min.
IA_LIMITE_USUARIO_DIA=""
IA_CONCORRENCIA_CONTA=""
IA_CONCORRENCIA_GLOBAL=""
IA_MAX_PAGINAS=""
IA_MAX_MB=""
IA_MAX_SAIDA=""
IA_TENTATIVAS=""
IA_MARGEM_RESERVA=""
IA_TOKENS_POR_PAGINA=""
IA_RESERVA_EXPIRA_MIN=""

# --- WhatsApp Business (Meta). Fora do escopo desta rodada; vazio = sem WhatsApp. ---
# Onde: Meta for Developers > WhatsApp. Os modelos precisam estar aprovados na Meta.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Confere a assinatura das mensagens recebidas (SAIR). OBRIGATÓRIA se o webhook estiver ligado.
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""

# --- Chaves de recurso (chave esconde, nunca apaga) ---
# Modo piloto (A6). Padrão true: esconde assessoria, trocar de conta, Recuperado, histórico do órgão e guias fora do piloto.
MODO_PILOTO="true"
# Jornada de 40 horas (D0, chave mestra). Padrão false: só PAINEL_EMAILS veem, com a marca de simulação. Ligar depois do "de acordo" do advogado e do contador.
JORNADA_REGRA_CONFIRMADA=""
# Datas da EC 141/2026, a confirmar com o jurídico (AAAA-MM-DD). Vazias: 42 h em 2026-12-16, 40 h em 2027-12-16, aditivo até 2027-10-16.
JORNADA_42H_INICIO=""
JORNADA_40H_INICIO=""
JORNADA_ADITIVO_PRAZO=""
# Preço do pacote Jornada 40 horas por contrato (aparece só com a jornada liberada). Vazia: 990.
# (preço da Jornada 40h: faixas em src/lib/precos.ts, jornada40Faixas)
# Faixa da jornada no topo do site (aparece só com a jornada liberada e "true").
SITE_FAIXA_JORNADA=""
# "true" usa a promessa como título do site (depois de o dono aprovar o texto).
SITE_TITULO_PROMESSA=""
# "true" mostra "Pedir revisão de especialista" (só com revisores parceiros).
REVISAO_ESPECIALISTA_ATIVA=""

# --- Demonstração e limpezas (trava 2: nascem desligadas; leia as simulações antes de ligar) ---
# Máximo de demonstrações ativas ao mesmo tempo. Vazia: 300.
DEMO_MAX_ATIVAS=""
# "true": o worker apaga, de hora em hora, as demonstrações com mais de 4 horas. Simulação: scripts/limpar-demos.ts
LIMPEZA_DEMOS_AUTOMATICA=""
# "true": o worker apaga, uma vez por dia, os documentos de contas canceladas há mais de 30 dias (cobrança e registros ficam).
# Simulação: scripts/limpar-contas-canceladas.ts
LIMPEZA_CONTAS_CANCELADAS=""
