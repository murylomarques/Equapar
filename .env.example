# =====================================================================
# Equapar: variáveis de ambiente. Copie para .env e preencha.
# OBRIGATÓRIA = o sistema não sobe sem ela. OPCIONAL = vazia liga o modo
# simulação ou desliga o recurso (nada é enviado a serviço de terceiro).
# =====================================================================

# --- Base -------------------------------------------------------------

# OBRIGATÓRIA. PostgreSQL. Local: `docker compose up -d` (porta 5440). Use 127.0.0.1, não localhost (IPv6 no Windows).
DATABASE_URL="postgresql://equapar:equapar_local@127.0.0.1:5440/equapar?schema=public"

# OBRIGATÓRIA. Segredo de 32+ caracteres: cifra o segredo das duas etapas e assina links (confirmação, senha, convite, Raio-X).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=""

# OBRIGATÓRIA. Endereço público (links dos avisos). Em produção, HTTPS: liga o cookie __Host-, o HSTS e o upgrade-insecure-requests.
APP_URL="http://localhost:3000"

# OPCIONAL. Onde ficam os arquivos enviados. Vazio = disco (STORAGE_DIR). "s3" = bucket privado compatível com S3
# (AWS S3, Cloudflare R2, MinIO…). Em produção, use s3: o app fica sem estado e pode ter mais de uma instância.
ARMAZENAMENTO=""
# OPCIONAL. Pasta dos arquivos no modo disco (padrão ./storage).
STORAGE_DIR="./storage"
# Com ARMAZENAMENTO=s3: bucket PRIVADO, região e, para R2/MinIO, o endpoint. Credenciais pelas variáveis padrão da AWS
# (AWS_ACCESS_KEY_ID e AWS_SECRET_ACCESS_KEY) ou pelo papel da máquina.
S3_BUCKET=""
S3_REGION=""
S3_ENDPOINT=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# OPCIONAL. Cabeçalho com o IP do cliente posto pelo proxy de confiança (ex.: cf-connecting-ip, x-real-ip, x-forwarded-for).
# Vazio = o limite de tentativas e as cotas por IP ficam desligados (continuam os por e-mail). Nunca confie em cabeçalho que o navegador possa mandar.
TRUSTED_PROXY_HEADER=""

# OPCIONAL. Segredo do agendador externo que chama /api/cron/avisos (cabeçalho Authorization: Bearer ...).
CRON_SECRET=""

# OPCIONAL. "true" = o próprio servidor roda os avisos de hora em hora (um processo só). Com o worker da fase 1, deixe vazio.
AVISOS_AUTOMATICOS=""

# --- Integrações (vazias = SIMULAÇÃO: a mensagem vai para o log e para a tela Avisos) ---

# OPCIONAL. E-mail via SMTP. Ex.: smtp://usuario:senha@smtp.provedor.com:587
SMTP_URL=""
EMAIL_FROM="Equapar Avisos <avisos@equapar.com.br>"

# OPCIONAL. WhatsApp Business Cloud API (Meta). Os modelos precisam estar aprovados na Meta.
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# OPCIONAL (OBRIGATÓRIA em produção se o webhook estiver ligado). Confere a assinatura das mensagens recebidas (SAIR).
WHATSAPP_APP_SECRET=""
# OPCIONAL. Token de verificação do webhook na Meta.
WHATSAPP_VERIFY_TOKEN=""

# OPCIONAL. Leitura de planilha em PDF com IA (Claude). Vazio = leitura de PDF desligada (Excel continua).
ANTHROPIC_API_KEY=""

# OPCIONAL. Login com Google (OAuth). Vazio = o botão não aparece.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OPCIONAL. Captcha Cloudflare Turnstile nos formulários públicos. Vazio = simulação (aceita e registra no log).
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Operação -------------------------------------------------------------

# OPCIONAL. E-mails (separados por vírgula) que veem o painel interno /app/interno. Vazio = ninguém.
PAINEL_EMAILS=""

# OPCIONAL. Alerta de erro: endpoint que recebe JSON (relay do Sentry, Slack, Better Stack…). Vazio = simulação (só o log).
ERROS_WEBHOOK_URL=""

# --- Recursos que dependem de decisão do dono ---------------------------

# OPCIONAL. "true" mostra "Pedir revisão de especialista" (só com revisores parceiros e o fluxo ligado).
REVISAO_ESPECIALISTA_ATIVA=""
