{
  "name": "equapar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=22.12 <25",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed-dev.ts",
    "avisos": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/avisos.ts",
    "setup": "npm run db:up && prisma migrate deploy && prisma generate && npm run db:seed",
    "e2e": "node e2e/fluxo.mjs desktop && node e2e/fluxo.mjs celular && node e2e/assessoria-2fa.mjs",
    "e2e:a11y": "node e2e/acessibilidade.mjs",
    "e2e:teclado": "node e2e/teclado.mjs",
    "db:seed:demo": "tsx --env-file=.env prisma/seed-demo.ts",
    "test:db": "node --env-file=.env -e \"process.env.TESTE_BANCO=1;require('child_process').execSync('npx vitest run --dir src',{stdio:'inherit',env:process.env})\"",
    "worker": "tsx --tsconfig tsconfig.worker.json --env-file=.env scripts/worker.ts",
    "worker:prod": "tsx --tsconfig tsconfig.worker.json scripts/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@aws-sdk/client-s3": "^3.1168.0",
    "@aws-sdk/s3-request-presigner": "^3.1168.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "decimal.js": "^10.6.0",
    "docx": "^9.15.3",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.2",
    "lucide-react": "^1.72.0",
    "next": "16.4.6",
    "nodemailer": "^10.5.0",
    "otpauth": "^9.6.0",
    "pdf-lib": "^1.17.1",
    "prisma": "^6.19.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "axe-core": "^4.14.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "lighthouse": "^12.8.2",
    "playwright-core": "^1.65.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed-dev.ts"
  }
}
